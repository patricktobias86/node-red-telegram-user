{
  "name": "@patricktobias86/node-red-telegram-user",
  "version": "1.5.4",
  "description": "Node-RED nodes to communicate with a Telegram user.",
  "main": "nodes/config.js",
  "keywords": [
    "node-red",
    "telegram"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/patricktobias86/node-red-telegram-user.git"
  },
