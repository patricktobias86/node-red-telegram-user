    "name": "Patrick Tobias",
    "url": "https://github.com/patricktobias86"
  },
  "engines": {
    "node": ">=20"
  },
  "bugs": {
    "url": "https://github.com/patricktobias86/node-red-telegram-user/issues"
  },
